# Copy to .env.local before running, or set via docker-compose.
NODE_ENV=development
PORT=5000

# MySQL connection. Use "localhost" when running the backend directly on the host;
# "db" resolves only inside the docker-compose network.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=voting_college

# JWT secret — change in production
JWT_SECRET=super-secret-change-me-please-1234567890
JWT_EXPIRES_IN=7d
